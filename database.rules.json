{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['email'])"
        },
        "stats": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "credentials": {
          ".read": false,
          ".write": false
        },
        "connections": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "oauth": {
      ".read": false,
      ".write": false
    }
  }
}
