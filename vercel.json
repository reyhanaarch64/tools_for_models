{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth-authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth-token"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/oauth-register"
    },
    {
      "source": "/oauth/authorize/complete",
      "destination": "/api/oauth-authorize-complete"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth-authorization-server"
    },
    {
      "source": "/oauth-login",
      "destination": "/oauth-login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "installCommand": "npm install --no-audit --no-fund",
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60
    }
  }
}
